@model IEnumerable<SmartGearOnline.Models.Category>

@{
    ViewData["Title"] = "Index";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center">Categories Management</h1> <br />
        </div>

        <div class="row">
            <div class="col-12">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.CategoryName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.CategoryDescription)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.CategoryId)
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.CategoryName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CategoryDescription)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CategoryId)
                            </td>
                            <td>
                                    <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-warning bm-me">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-dark bm-me">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-dark bm-me">Delete</a>
                                </td>
                        </tr>
                }
                    </tbody>
                </table>
                <div class="text-center m-4">
                    <a asp-action="Create" class="btn btn-warning bm-me">New Category</a>
                </div>
            </div>
        </div>
    </div>
</div>
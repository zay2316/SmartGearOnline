@model List<(string Text, string Url)>

@if (Model != null)
{
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SmartGearOnline</a>
            <div class="collapse navbar-collapse justify-content-center">
                <ul class="navbar-nav">
                    @foreach (var link in Model)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" href="@link.Url">@link.Text</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Register">Register</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
}
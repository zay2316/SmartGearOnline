@model IEnumerable<SmartGearOnline.Models.Product>

@{
    ViewData["Title"] = "Product List";
}

<h2>Products</h2>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var product in Model)
    {
        <div class="col">
            @await Html.PartialAsync("_ProductCard", product)
        </div>
    }
</div>

@model IEnumerable<SmartGearOnline.Models.Product>

@{
    ViewData["Title"] = "Product List";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center">Product List</h1> <br />
        </div>

        <div class="row">
            <div class="col-12">
                @if (Model != null && Model.Any())
                {
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.First().Name)</th>
                                <th>@Html.DisplayNameFor(model => model.First().Price)</th>
                                <th>Total Price</th>
                                <th>@Html.DisplayNameFor(model => model.First().CategoryId)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Price)</td>
                                    <td>@item.TotalPrice.ToString("C")</td>
                                    <td>@Html.DisplayFor(modelItem => item.CategoryId)</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning bm-me">Details</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-dark bm-me">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-dark bm-me">Delete</a>
                                        <button id="cartBtn" class="btn btn-warning">Add to Cart</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No products found.</p>
                }

                <div class="row">
                    <div class="col-12 text-center mb-3">
                        <a asp-action="Create" class="btn btn-warning bm-me">Create New</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#cartBtn").click(function () {
                alert("Item added to cart!");
            });
        });
    </script>
}
@{
    ViewData["Title"] = "Product List";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center">Product List</h1><br />
        </div>

        <div class="col-12">
            <table class="table table-striped table-bordered" id="productTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Total Price</th>
                        <th>Category</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <!-- AJAX fills the body with products from the API -->
                </tbody>
            </table>

            <div class="text-center mb-3">
                <a asp-action="Create" class="btn btn-warning bm-me">Create New</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        const apiUrl = "/api/products";

        function loadProducts() {
            $.get(apiUrl, function (data) {
                const tbody = $("#productTable tbody");
                tbody.empty();
                data.forEach(item => {
                    tbody.append(`
                        <tr>
                            <td>${item.name}</td>
                            <td>${item.price}</td>
                            <td>${(item.price).toLocaleString('en-US', { style: 'currency', currency: 'USD' })}</td>
                            <td>${item.categoryId}</td>
                            <td>
                                <a href="/Products/Details/${item.id}" class="btn btn-warning bm-me">Details</a>
                                <a href="/Products/Edit/${item.id}" class="btn btn-dark bm-me">Edit</a>
                                <a href="/Products/Delete/${item.id}" class="btn btn-dark bm-me">Delete</a>
                                <button class="btn btn-warning add-to-cart" data-id="${item.id}">Add to Cart</button>
                            </td>
                        </tr>
                    `);
                });
            });
        }

        $(document).on("click", ".add-to-cart", function () {
            const id = $(this).data("id");
            alert(`Product ${id} added to cart!`);
        });

        $(document).ready(function () {
            loadProducts();
        });
    </script>
}